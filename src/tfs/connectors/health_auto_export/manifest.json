{
  "label": "Health Auto Export",
  "about": "The Health Auto Export app on your iPhone sends new Apple Health data to TFS with a REST API automation. Your computer must be on and reachable.",
  "routes": {"fetch": false, "push": true, "files": []},
  "asks": [],
  "stale_after_hours": 48,
  "app_ids": [],
  "notices_deletes": false,
  "sends": [],
  "setup": {
    "steps": [
      "Needs Health Auto Export Premium.",
      "Scan with your iPhone camera."
    ],
    "links": [
      {
        "label": "health metrics",
        "url": "com.HealthExport://automation?url={push_url}&name=TFS%20metrics&datatype=healthMetrics&format=json&exportversion=v2&period=lastsync&aggregatesleep=true&headers=Authorization,Bearer%20{token}"
      },
      {
        "label": "workouts",
        "url": "com.HealthExport://automation?url={push_url}&name=TFS%20workouts&datatype=workouts&format=json&exportversion=v2&period=lastsync&headers=Authorization,Bearer%20{token}"
      }
    ]
  }
}
